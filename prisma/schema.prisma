generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              Int              @id @default(autoincrement())
  email           String           @unique
  passwordHash    String?
  role            String
  phone           String?
  whatsapp        String?
  city            String?
  isBanned        Boolean          @default(false)
  isOnboarded     Boolean          @default(false)
  emailVerified   Boolean          @default(false)
  gender          String?
  createdAt       DateTime         @default(now())
  customerProfile CustomerProfile?
  sellerProfile   SellerProfile?
  orders          Order[]
  reviews         Review[]
  addresses       Address[]
}

model CustomerProfile {
  id              Int     @id @default(autoincrement())
  userId          Int     @unique
  fullName        String?
  deliveryAddress String?
  reviewerScore   Decimal @default(0)
  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum SellerType {
  SHOP
  RESTAURANT
}

model SellerProfile {
  id                   Int                @id @default(autoincrement())
  userId               Int                @unique
  sellerType           SellerType         @default(SHOP)
  businessName         String
  whatsappNumber       String?
  whatsappVerified     Boolean            @default(false)
  tradeLicense         String?
  city                 String?
  area                 String?
  latitude             Decimal?
  longitude            Decimal?
  workingDays          String?
  workingHours         String?
  deliveryAvailable    Boolean            @default(false)
  warrantyAvailable    Boolean            @default(false)
  warrantyDuration     String?
  maintenanceAvailable Boolean            @default(false)
  isOpen               Boolean            @default(true)
  approvedByAdmin      Boolean            @default(false)
  subscriptionStatus   String             @default("PENDING")
  createdAt            DateTime           @default(now())
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  products             Product[]
  orders               Order[]
  reviews              Review[]
  adCampaigns          AdCampaign[]
  stockMovements       StockMovement[]
  subscriptions        Subscription[]
  trackingPixel        TrackingPixel?
  retailerProducts     RetailerProduct[]
  productRequests      ProductRequest[]
  zoneCoverage         ShopZoneCoverage[]
}

model Subscription {
  id            Int           @id @default(autoincrement())
  sellerId      Int
  price         Decimal       @default(199)
  status        String        @default("pending")
  paymentMethod String?
  paymentStatus String        @default("unpaid")
  startDate     DateTime?
  endDate       DateTime?
  createdAt     DateTime      @default(now())
  seller        SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
}

model Category {
  id             Int             @id @default(autoincrement())
  name           String          @unique
  icon           String?
  subCategories  SubCategory[]
  products       Product[]
  masterProducts MasterProduct[]
}

model SubCategory {
  id         Int       @id @default(autoincrement())
  categoryId Int
  name       String
  category   Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  products   Product[]
}

enum UnitType {
  PIECE
  GRAM
  KILOGRAM
  LITER
  MILLILITER
  BUNDLE
}

enum StorageType {
  AMBIENT
  CHILLED
  FROZEN
}

model Product {
  id             Int              @id @default(autoincrement())
  sellerId       Int
  categoryId     Int
  subCategoryId  Int?
  brand          String?
  name           String
  description    String?
  images         String[]         @default([])
  isActive       Boolean          @default(true)
  unitType       UnitType?
  netWeight      Int?
  sellByWeight   Boolean          @default(false)
  originRegion   String?
  isPerishable   Boolean          @default(false)
  shelfLifeDays  Int?
  storage        StorageType?
  isHeritageGood Boolean          @default(false)
  createdAt      DateTime         @default(now())
  seller         SellerProfile    @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  category       Category         @relation(fields: [categoryId], references: [id])
  subCategory    SubCategory?     @relation(fields: [subCategoryId], references: [id])
  variants       ProductVariant[]
  reviews        Review[]
}

model ProductVariant {
  id             Int             @id @default(autoincrement())
  productId      Int
  label          String?
  price          Decimal
  stockQty       Int             @default(0)
  skuCode        String?         @unique
  image          String?
  createdAt      DateTime        @default(now())
  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems     OrderItem[]
  stockMovements StockMovement[]
}

model Address {
  id           Int           @id @default(autoincrement())
  userId       Int
  label        String?
  governorate  String
  district     String?
  zoneId       Int?
  area         String?
  street       String?
  building     String?
  floor        String?
  apartment    String?
  landmark     String?
  phone        String?
  contactPhone String?
  notes        String?
  isDefault    Boolean       @default(false)
  latitude     Decimal?
  longitude    Decimal?
  createdAt    DateTime      @default(now())
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  zone         DeliveryZone? @relation(fields: [zoneId], references: [id])
  orders       Order[]
}

model DeliveryZone {
  id           Int                @id @default(autoincrement())
  nameEn       String
  nameAr       String
  districts    String[]           @default([])
  baseFee      Decimal            @default(0)
  etaMinutes   Int                @default(60)
  isActive     Boolean            @default(true)
  createdAt    DateTime           @default(now())
  shopCoverage ShopZoneCoverage[]
  orders       Order[]
  addresses    Address[]
}

model ShopZoneCoverage {
  id            Int           @id @default(autoincrement())
  sellerId      Int
  zoneId        Int
  feeOverride   Decimal?
  minOrderValue Decimal       @default(0)
  cutoffTime    String?
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  seller        SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  zone          DeliveryZone  @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@unique([sellerId, zoneId])
}

model DeliveryWaitlist {
  id        Int      @id @default(autoincrement())
  district  String
  phone     String?
  createdAt DateTime @default(now())
}

// Shared OTP core for email + WhatsApp ownership verification. Only used
// directly when a channel has no external OTP service to delegate to
// (email always; WhatsApp only when no Twilio Verify credentials are
// configured — see lib/verification/whatsappOtp.js and DECISIONS.md).
model VerificationCode {
  id         Int       @id @default(autoincrement())
  channel    String // 'email' | 'whatsapp'
  target     String // email address or phone number
  purpose    String    @default("signup")
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([channel, target, purpose])
}

model Order {
  id                  Int           @id @default(autoincrement())
  customerId          Int
  sellerId            Int
  status              String        @default("PLACED")
  orderGroupId        String?
  total               Decimal
  currency            String        @default("EGP")
  commission          Decimal       @default(0)
  commissionRate      Decimal       @default(0.10)
  deliveryAddress     String
  addressId           Int?
  addressLabel        String?
  addressArea         String?
  addressBuilding     String?
  addressFloor        String?
  addressApartment    String?
  addressLandmark     String?
  addressContactPhone String?
  zoneId              Int?
  deliveryFee         Decimal       @default(0)
  promisedEta         DateTime?
  deliveryNotes       String?
  paymentMethod       String?
  paymentStatus       String        @default("unpaid")
  receiptUrl          String?
  createdAt           DateTime      @default(now())
  customer            User          @relation(fields: [customerId], references: [id])
  seller              SellerProfile @relation(fields: [sellerId], references: [id])
  address             Address?      @relation(fields: [addressId], references: [id])
  zone                DeliveryZone? @relation(fields: [zoneId], references: [id])
  items               OrderItem[]
}

model OrderItem {
  id               Int            @id @default(autoincrement())
  orderId          Int
  productVariantId Int
  quantity         Int
  priceAtPurchase  Decimal
  order            Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id])
}

model Review {
  id         Int           @id @default(autoincrement())
  customerId Int
  sellerId   Int
  productId  Int?
  rating     Int
  comment    String?
  createdAt  DateTime      @default(now())
  customer   User          @relation(fields: [customerId], references: [id])
  seller     SellerProfile @relation(fields: [sellerId], references: [id])
  product    Product?      @relation(fields: [productId], references: [id])
}

model AdCampaign {
  id         Int           @id @default(autoincrement())
  sellerId   Int
  type       String
  targetCity String?
  budget     Decimal?
  startDate  DateTime
  endDate    DateTime
  status     String        @default("active")
  createdAt  DateTime      @default(now())
  seller     SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  stats      AdStat[]
}

model AdStat {
  id          Int        @id @default(autoincrement())
  campaignId  Int
  impressions Int        @default(0)
  clicks      Int        @default(0)
  conversions Int        @default(0)
  date        DateTime   @default(now())
  campaign    AdCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}

model TrackingPixel {
  id        String        @id @default(uuid())
  sellerId  Int           @unique
  createdAt DateTime      @default(now())
  seller    SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  events    PixelEvent[]
}

model PixelEvent {
  id        Int           @id @default(autoincrement())
  pixelId   String
  sellerId  Int
  ip        String?
  userAgent String?
  referrer  String?
  country   String?
  createdAt DateTime      @default(now())
  pixel     TrackingPixel @relation(fields: [pixelId], references: [id], onDelete: Cascade)
}

model MasterProduct {
  id               Int               @id @default(autoincrement())
  name             String            @unique
  description      String?
  images           String[]          @default([])
  categoryId       Int
  brand            String?
  productType      String?
  sku              String?
  tags             String[]          @default([])
  specs            Json?
  variants         Json?
  priceMin         Decimal?
  priceMax         Decimal?
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  category         Category          @relation(fields: [categoryId], references: [id])
  retailerProducts RetailerProduct[]
}

model RetailerProduct {
  id              Int           @id @default(autoincrement())
  retailerId      Int
  masterProductId Int
  price           Decimal
  stockQty        Int           @default(0)
  status          String        @default("PENDING")
  adminNote       String?
  createdAt       DateTime      @default(now())
  retailer        SellerProfile @relation(fields: [retailerId], references: [id], onDelete: Cascade)
  masterProduct   MasterProduct @relation(fields: [masterProductId], references: [id])

  @@unique([retailerId, masterProductId])
}

model ProductRequest {
  id         Int           @id @default(autoincrement())
  retailerId Int
  name       String
  notes      String?
  status     String        @default("PENDING")
  createdAt  DateTime      @default(now())
  retailer   SellerProfile @relation(fields: [retailerId], references: [id], onDelete: Cascade)
}

model GlobalEvent {
  id        Int      @id @default(autoincrement())
  ip        String?
  userAgent String?
  referrer  String?
  country   String?
  page      String?
  createdAt DateTime @default(now())
}

model StockMovement {
  id               Int            @id @default(autoincrement())
  sellerId         Int
  productVariantId Int
  movementType     String
  quantity         Int
  note             String?
  createdAt        DateTime       @default(now())
  seller           SellerProfile  @relation(fields: [sellerId], references: [id])
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id])
}
