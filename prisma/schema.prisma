generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                        Int                 @id @default(autoincrement())
  email                     String              @unique
  passwordHash              String?
  role                      String
  phone                     String?
  whatsapp                  String?
  city                      String?
  isBanned                  Boolean             @default(false)
  isOnboarded               Boolean             @default(false)
  emailVerified             Boolean             @default(false)
  // Set once, right after the welcome email send attempt at account
  // creation (register route + Google OAuth first-time signIn) — never
  // touched on login or profile update, so it doubles as the "already
  // sent" guard against duplicate welcome emails.
  welcomeEmailSentAt        DateTime?
  // Set on a successful password reset (never on registration or normal
  // login). middleware.js rejects any JWT whose `iat` predates this, so a
  // stolen/leaked token stops working the moment the password changes —
  // see app/api/auth/reset-password/route.js.
  passwordChangedAt         DateTime?
  gender                    String?
  createdAt                 DateTime            @default(now())
  customerProfile           CustomerProfile?
  sellerProfile             SellerProfile?
  orders                    Order[]
  reviews                   Review[]
  addresses                 Address[]
  walletTransactionsCreated WalletTransaction[] @relation("WalletTransactionCreatedBy")
  commissionRateChanges     CommissionSetting[] @relation("CommissionSettingUpdatedBy")
}

model CustomerProfile {
  id              Int     @id @default(autoincrement())
  userId          Int     @unique
  fullName        String?
  deliveryAddress String?
  reviewerScore   Decimal @default(0)
  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum SellerType {
  SHOP
  RESTAURANT
}

model SellerProfile {
  id                   Int                 @id @default(autoincrement())
  userId               Int                 @unique
  sellerType           SellerType          @default(SHOP)
  businessName         String
  // Short tagline shown on the shop/restaurant page header (e.g. a
  // restaurant's slogan). Bilingual: Arabic required in the seller form,
  // English optional — customer pages fall back to descriptionAr when
  // descriptionEn is empty for the 'en' locale (see app/restaurant/[id]/
  // page.js), never rendering an empty description either way.
  descriptionAr        String?
  descriptionEn        String?
  // Required to complete seller signup (see /api/auth/register) for new
  // sellers; nullable so existing sellers aren't locked out — the
  // dashboard shows a persistent prompt instead (components/LogoPrompt.js).
  logoUrl              String?
  whatsappNumber       String?
  whatsappVerified     Boolean             @default(false)
  tradeLicense         String?
  city                 String?
  area                 String?
  latitude             Decimal?
  longitude            Decimal?
  workingDays          String?
  workingHours         String?
  deliveryAvailable    Boolean             @default(false)
  warrantyAvailable    Boolean             @default(false)
  warrantyDuration     String?
  maintenanceAvailable Boolean             @default(false)
  isOpen               Boolean             @default(true)
  approvedByAdmin      Boolean             @default(false)
  subscriptionStatus   String              @default("PENDING")
  walletBalance        Decimal             @default(0)
  createdAt            DateTime            @default(now())
  user                 User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  products             Product[]
  orders               Order[]
  reviews              Review[]
  adCampaigns          AdCampaign[]
  stockMovements       StockMovement[]
  subscriptions        Subscription[]
  trackingPixel        TrackingPixel?
  retailerProducts     RetailerProduct[]
  productRequests      ProductRequest[]
  zoneCoverage         ShopZoneCoverage[]
  walletTransactions   WalletTransaction[]
}

// Append-only ledger — the source of truth for a shop's wallet history.
// SellerProfile.walletBalance is the running total, always mutated in the
// same DB transaction as the ledger row that explains the change (see
// lib/wallet.js). amount is signed: positive for TOPUP, negative for
// COMMISSION, either sign for ADJUSTMENT.
enum WalletTransactionType {
  TOPUP
  COMMISSION
  ADJUSTMENT
}

model WalletTransaction {
  id           Int                   @id @default(autoincrement())
  shopId       Int
  amount       Decimal
  type         WalletTransactionType
  balanceAfter Decimal
  orderId      Int?
  note         String?
  createdBy    Int?
  createdAt    DateTime              @default(now())
  // The commission rate actually applied to this specific COMMISSION row
  // (fraction, e.g. 0.05 = 5%) — null for TOPUP/ADJUSTMENT rows, which
  // have no rate. Set once at creation from CommissionSetting's current
  // rate and never touched again: a shop's past ledger entries must keep
  // showing what they were actually charged even after the platform rate
  // changes later. See lib/wallet.js's deductCommission().
  commissionRate Decimal?
  shop         SellerProfile         @relation(fields: [shopId], references: [id], onDelete: Cascade)
  order        Order?                @relation(fields: [orderId], references: [id])
  admin        User?                 @relation("WalletTransactionCreatedBy", fields: [createdBy], references: [id])

  // Idempotency guard: at most one COMMISSION row per (orderId, shopId).
  // Postgres treats NULLs as distinct, so this never restricts TOPUP/
  // ADJUSTMENT rows (orderId is always null for those).
  @@unique([orderId, shopId, type])
  @@index([shopId, createdAt])
}

// Append-only: changing the commission rate INSERTS a new row rather than
// updating one in place, so the table doubles as its own audit log (who
// changed it and when — see app/api/admin/commission-rate/route.js). The
// current rate is always the most recent row (highest id / createdAt).
// lib/wallet.js's getCurrentCommissionRate() reads it; deductCommission()
// snapshots that value onto WalletTransaction.commissionRate per charge,
// which is what actually protects historical ledger entries — this table
// changing never rewrites anything already charged.
model CommissionSetting {
  id        Int      @id @default(autoincrement())
  rate      Decimal // fraction, e.g. 0.05 = 5%
  createdAt DateTime @default(now())
  updatedBy Int?
  updatedByUser User? @relation("CommissionSettingUpdatedBy", fields: [updatedBy], references: [id])

  @@index([createdAt])
}

model Subscription {
  id            Int           @id @default(autoincrement())
  sellerId      Int
  price         Decimal       @default(199)
  status        String        @default("pending")
  paymentMethod String?
  paymentStatus String        @default("unpaid")
  startDate     DateTime?
  endDate       DateTime?
  createdAt     DateTime      @default(now())
  seller        SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
}

model Category {
  id             Int             @id @default(autoincrement())
  name           String          @unique
  icon           String?
  // Internal-only categories (e.g. the single "Food" bucket every
  // restaurant dish is auto-filed under — see Product.menuSection) are
  // never returned by GET /api/categories and never appear in the
  // customer "Shop by Category" grid/counts. Sellers never choose one;
  // the server assigns it. Default false covers every existing row.
  isInternal     Boolean         @default(false)
  subCategories  SubCategory[]
  products       Product[]
  masterProducts MasterProduct[]
}

model SubCategory {
  id         Int       @id @default(autoincrement())
  categoryId Int
  name       String
  category   Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  products   Product[]
}

enum UnitType {
  PIECE
  GRAM
  KILOGRAM
  LITER
  MILLILITER
  BUNDLE
}

enum StorageType {
  AMBIENT
  CHILLED
  FROZEN
}

model Product {
  id             Int              @id @default(autoincrement())
  sellerId       Int
  categoryId     Int
  subCategoryId  Int?
  brand          String?
  name           String
  description    String?
  images         String[]         @default([])
  isActive       Boolean          @default(true)
  unitType       UnitType?
  netWeight      Int?
  sellByWeight   Boolean          @default(false)
  originRegion   String?
  isPerishable   Boolean          @default(false)
  shelfLifeDays  Int?
  storage        StorageType?
  isHeritageGood Boolean          @default(false)
  // Restaurant menu grouping (e.g. "برجر", "مشويات وشاورما", "جانبية") —
  // free text, owner-defined per restaurant. Always null for SHOP
  // sellers' products; RESTAURANT sellers group their menu by it (see
  // /api/restaurants/[id] and app/restaurant/[id]/page.js). categoryId
  // above stays required by the schema but is not customer-facing for
  // dishes — restaurant products are excluded from category browse
  // entirely (see app/api/products/route.js), so its value here is a
  // technical placeholder, not a real classification.
  menuSection    String?
  createdAt      DateTime         @default(now())
  seller         SellerProfile    @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  category       Category         @relation(fields: [categoryId], references: [id])
  subCategory    SubCategory?     @relation(fields: [subCategoryId], references: [id])
  variants       ProductVariant[]
  reviews        Review[]
}

model ProductVariant {
  id             Int             @id @default(autoincrement())
  productId      Int
  label          String?
  price          Decimal
  stockQty       Int             @default(0)
  skuCode        String?         @unique
  image          String?
  createdAt      DateTime        @default(now())
  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems     OrderItem[]
  stockMovements StockMovement[]
}

model Address {
  id           Int           @id @default(autoincrement())
  userId       Int
  label        String?
  governorate  String
  district     String?
  zoneId       Int?
  area         String?
  street       String?
  building     String?
  floor        String?
  apartment    String?
  landmark     String?
  phone        String?
  contactPhone String?
  notes        String?
  isDefault    Boolean       @default(false)
  latitude     Decimal?
  longitude    Decimal?
  createdAt    DateTime      @default(now())
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  zone         DeliveryZone? @relation(fields: [zoneId], references: [id])
  orders       Order[]
}

model DeliveryZone {
  id           Int                @id @default(autoincrement())
  nameEn       String
  nameAr       String
  districts    String[]           @default([])
  baseFee      Decimal            @default(0)
  etaMinutes   Int                @default(60)
  isActive     Boolean            @default(true)
  createdAt    DateTime           @default(now())
  shopCoverage ShopZoneCoverage[]
  orders       Order[]
  addresses    Address[]
}

model ShopZoneCoverage {
  id            Int           @id @default(autoincrement())
  sellerId      Int
  zoneId        Int
  feeOverride   Decimal?
  minOrderValue Decimal       @default(0)
  cutoffTime    String?
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  seller        SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  zone          DeliveryZone  @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@unique([sellerId, zoneId])
}

model DeliveryWaitlist {
  id        Int      @id @default(autoincrement())
  district  String
  phone     String?
  createdAt DateTime @default(now())
}

// Shared OTP core for email + WhatsApp ownership verification. Only used
// directly when a channel has no external OTP service to delegate to
// (email always; WhatsApp only when no Twilio Verify credentials are
// configured — see lib/verification/whatsappOtp.js and DECISIONS.md).
model VerificationCode {
  id         Int       @id @default(autoincrement())
  channel    String // 'email' | 'whatsapp'
  target     String // email address or phone number
  purpose    String    @default("signup")
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([channel, target, purpose])
}

model Order {
  id                  Int                 @id @default(autoincrement())
  customerId          Int
  sellerId            Int
  status              String              @default("PLACED")
  orderGroupId        String?
  total               Decimal
  currency            String              @default("EGP")
  commission          Decimal             @default(0)
  commissionRate      Decimal             @default(0.10)
  deliveryAddress     String
  addressId           Int?
  addressLabel        String?
  addressArea         String?
  addressBuilding     String?
  addressFloor        String?
  addressApartment    String?
  addressLandmark     String?
  addressContactPhone String?
  zoneId              Int?
  deliveryFee         Decimal             @default(0)
  promisedEta         DateTime?
  deliveryNotes       String?
  paymentMethod       String?
  paymentStatus       String              @default("unpaid")
  receiptUrl          String?
  createdAt           DateTime            @default(now())
  customer            User                @relation(fields: [customerId], references: [id])
  seller              SellerProfile       @relation(fields: [sellerId], references: [id])
  address             Address?            @relation(fields: [addressId], references: [id])
  zone                DeliveryZone?       @relation(fields: [zoneId], references: [id])
  items               OrderItem[]
  walletTransactions  WalletTransaction[]
}

model OrderItem {
  id               Int            @id @default(autoincrement())
  orderId          Int
  productVariantId Int
  quantity         Int
  priceAtPurchase  Decimal
  order            Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id])
}

model Review {
  id         Int           @id @default(autoincrement())
  customerId Int
  sellerId   Int
  productId  Int?
  rating     Int
  comment    String?
  createdAt  DateTime      @default(now())
  customer   User          @relation(fields: [customerId], references: [id])
  seller     SellerProfile @relation(fields: [sellerId], references: [id])
  product    Product?      @relation(fields: [productId], references: [id])
}

model AdCampaign {
  id         Int           @id @default(autoincrement())
  sellerId   Int
  type       String
  targetCity String?
  budget     Decimal?
  startDate  DateTime
  endDate    DateTime
  status     String        @default("active")
  createdAt  DateTime      @default(now())
  seller     SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  stats      AdStat[]
}

model AdStat {
  id          Int        @id @default(autoincrement())
  campaignId  Int
  impressions Int        @default(0)
  clicks      Int        @default(0)
  conversions Int        @default(0)
  date        DateTime   @default(now())
  campaign    AdCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}

model TrackingPixel {
  id        String        @id @default(uuid())
  sellerId  Int           @unique
  createdAt DateTime      @default(now())
  seller    SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  events    PixelEvent[]
}

model PixelEvent {
  id        Int           @id @default(autoincrement())
  pixelId   String
  sellerId  Int
  ip        String?
  userAgent String?
  referrer  String?
  country   String?
  createdAt DateTime      @default(now())
  pixel     TrackingPixel @relation(fields: [pixelId], references: [id], onDelete: Cascade)
}

model MasterProduct {
  id               Int               @id @default(autoincrement())
  name             String            @unique
  description      String?
  images           String[]          @default([])
  categoryId       Int
  brand            String?
  productType      String?
  sku              String?
  tags             String[]          @default([])
  specs            Json?
  variants         Json?
  priceMin         Decimal?
  priceMax         Decimal?
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  category         Category          @relation(fields: [categoryId], references: [id])
  retailerProducts RetailerProduct[]
}

model RetailerProduct {
  id              Int           @id @default(autoincrement())
  retailerId      Int
  masterProductId Int
  price           Decimal
  stockQty        Int           @default(0)
  status          String        @default("PENDING")
  adminNote       String?
  createdAt       DateTime      @default(now())
  retailer        SellerProfile @relation(fields: [retailerId], references: [id], onDelete: Cascade)
  masterProduct   MasterProduct @relation(fields: [masterProductId], references: [id])

  @@unique([retailerId, masterProductId])
}

model ProductRequest {
  id         Int           @id @default(autoincrement())
  retailerId Int
  name       String
  notes      String?
  status     String        @default("PENDING")
  createdAt  DateTime      @default(now())
  retailer   SellerProfile @relation(fields: [retailerId], references: [id], onDelete: Cascade)
}

model GlobalEvent {
  id        Int      @id @default(autoincrement())
  ip        String?
  userAgent String?
  referrer  String?
  country   String?
  page      String?
  createdAt DateTime @default(now())
}

model StockMovement {
  id               Int            @id @default(autoincrement())
  sellerId         Int
  productVariantId Int
  movementType     String
  quantity         Int
  note             String?
  createdAt        DateTime       @default(now())
  seller           SellerProfile  @relation(fields: [sellerId], references: [id])
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id])
}
